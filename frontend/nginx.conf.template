# Rendered at container start by the nginx image (envsubst on /etc/nginx/templates).
# Upstreams are configurable so the same image runs under Docker Compose and Azure
# Container Apps. Host is set to the upstream host because Container Apps ingress
# routes internal traffic by Host header. The read timeout covers chained cold
# starts when the APIs scale from zero (Container Apps ingress allows 240 s).
server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Compresión gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # SPA routing: reenvía rutas del cliente al index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy: Monitoring Registry
    location /registry/ {
        proxy_pass ${REGISTRY_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse proxy: Telemetry Ingestion
    location /telemetry/ {
        proxy_pass ${TELEMETRY_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse proxy: Alert Management
    location /alerts/ {
        proxy_pass ${ALERTS_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
