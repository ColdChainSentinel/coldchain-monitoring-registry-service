# ====================================================================
# Variables de Entorno para Docker Compose - ColdChain Sentinel
# Copiar este archivo como '.env' para personalizar valores locales.
# NUNCA subir el archivo '.env' con contraseñas reales a Git.
# ====================================================================

# Configuración de Base de Datos PostgreSQL
DB_USER=coldchain
DB_PASSWORD=coldchain123
POSTGRES_PORT=5432

# Puertos locales expuestos para los microservicios
REGISTRY_PORT=8080
TELEMETRY_PORT=8081
ALERTS_PORT=8082

# Puerto local expuesto para el Frontend Web
FRONTEND_PORT=80

